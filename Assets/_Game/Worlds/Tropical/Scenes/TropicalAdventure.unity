  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.22, g: 0.11, b: 0.04, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 30
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 1
    m_VerticalOverflow: 1
    m_LineSpacing: 1.05
  m_Text: '<size=46><b>WORLDS OF MINI GOLF</b></size>

    <size=36><i>Tropical Adventure</i></size>


    <b>Putt:</b>
    swing through the ball   <b>A:</b> go to ball

    <b>B:</b> ball back to last
    shot spot   <b>X:</b> scorecard

    <b>Y (hold):</b> swap hands   <b>Stick:</b>
    teleport / turn

    <b>Left grip:</b> drag to move   <b>Right grip + stick:</b>
    putter

    <b>Look at your free wrist</b> for your score'
